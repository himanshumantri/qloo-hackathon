PORT=4000
# Comma-separated allowed frontend origins (add your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173
# Add your Qloo API key here (keep it server-side only)
QLOO_API_KEY=
# Anthropic API key for the agent (server-side only)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5) and the daily AI request cap
# ANTHROPIC_MODEL=claude-sonnet-5-5
# MAX_DAILY_AI_CALLS=300
