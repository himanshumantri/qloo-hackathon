PORT=4000
# Comma-separated allowed frontend origins (add your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173
# Qloo hackathon API key (server-side only)
QLOO_API_KEY=
# Anthropic API key for the planning agent (server-side only)
ANTHROPIC_API_KEY=
# Optional: model (default claude-haiku-5-5), daily AI request cap, concurrent plans
# ANTHROPIC_MODEL=claude-haiku-5-5
# MAX_DAILY_AI_CALLS=300
# MAX_CONCURRENT_PLANS=3
# Optional: log every Qloo call the agent makes
# AGENT_TRACE=1
